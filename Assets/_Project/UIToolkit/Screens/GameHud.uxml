<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UIToolkit/Theme/EcosTheme.uss" />
    <ui:VisualElement name="GameHud" class="fill" picking-mode="Ignore">

        <!-- Barra superior -->
        <ui:VisualElement class="row" style="position: absolute; left: 24px; right: 24px; top: 18px;">
            <!-- grupo de estadísticas izquierda -->
            <ui:VisualElement class="row grow">
                <ui:VisualElement class="chip" style="margin-right: 10px;">
                    <ui:VisualElement style="width: 15px; height: 15px; margin-right: 7px; background-image: url('project://database/Assets/_Project/UIToolkit/Theme/Icons/clock.png'); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(34,211,238);" />
                    <ui:Label name="TimeValue" text="00:42" style="font-size: 14px; color: rgb(215,238,246);" />
                </ui:VisualElement>
                <ui:VisualElement class="chip" style="margin-right: 10px;">
                    <ui:VisualElement style="width: 15px; height: 15px; margin-right: 7px; background-image: url('project://database/Assets/_Project/UIToolkit/Theme/Icons/heart.png'); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(239,68,68);" />
                    <ui:Label name="DeathsValue" text="2" style="font-size: 14px; color: rgb(215,238,246);" />
                </ui:VisualElement>
                <ui:VisualElement class="chip" style="margin-right: 10px;">
                    <ui:VisualElement style="width: 15px; height: 15px; margin-right: 7px; background-image: url('project://database/Assets/_Project/UIToolkit/Theme/Icons/people.png'); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(34,211,238);" />
                    <ui:Label name="EchoesValue" text="3 / 10" style="font-size: 14px; color: rgb(215,238,246);" />
                </ui:VisualElement>
                <ui:VisualElement class="chip" style="margin-right: 10px;">
                    <ui:VisualElement style="width: 15px; height: 15px; margin-right: 7px; background-image: url('project://database/Assets/_Project/UIToolkit/Theme/Icons/gem.png'); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(125,249,255);" />
                    <ui:Label name="CrystalsValue" text="1 / 3" style="font-size: 14px; color: rgb(215,238,246);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- derecha: fragmentos, puntuación, pausa -->
            <ui:VisualElement class="row">
                <ui:VisualElement class="chip" style="margin-right: 10px;">
                    <ui:VisualElement style="width: 15px; height: 15px; margin-right: 7px; background-image: url('project://database/Assets/_Project/UIToolkit/Theme/Icons/coin.png'); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(251,191,36);" />
                    <ui:Label name="FragmentsValue" text="3,500" style="font-size: 14px; color: rgb(251,191,36);" />
                </ui:VisualElement>
                <ui:VisualElement class="chip" style="margin-right: 10px;">
                    <ui:VisualElement style="width: 15px; height: 15px; margin-right: 7px; background-image: url('project://database/Assets/_Project/UIToolkit/Theme/Icons/star.png'); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(251,191,36);" />
                    <ui:Label name="ScoreValue" text="1280" style="font-size: 14px; color: rgb(215,238,246);" />
                </ui:VisualElement>
                <ui:Button name="BtnPause" class="carousel-arrow" style="width: 38px; height: 38px; background-image: url('project://database/Assets/_Project/UIToolkit/Theme/Icons/cog.png');" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Indicador de habilidad (abajo-izquierda) -->
        <ui:VisualElement class="panel" style="position: absolute; left: 24px; bottom: 24px; width: 230px;">
            <ui:VisualElement class="row" style="align-items: center;">
                <ui:VisualElement name="AbilityIcon" style="width: 40px; height: 40px; margin-right: 12px; background-image: url('project://database/Assets/_Project/UIToolkit/Theme/Icons/hourglass.png'); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(125,249,255);" />
                <ui:VisualElement class="grow">
                    <ui:VisualElement class="row">
                        <ui:Label name="AbilityName" text="ECO PROLONGADO" class="grow" style="font-size: 12px; color: rgb(125,249,255); letter-spacing: 1px;" />
                        <ui:Label text="Q" class="dim" style="font-size: 12px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="bar-track" style="margin-top: 8px;"><ui:VisualElement name="AbilityFill" class="bar-fill" style="width: 70%;" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Pista de controles (abajo-derecha) -->
        <ui:VisualElement style="position: absolute; right: 24px; bottom: 24px; align-items: flex-end;">
            <ui:Label text="WASD MOVER · E INTERACTUAR · R REINICIAR" class="dim" style="font-size: 11px; letter-spacing: 2px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
